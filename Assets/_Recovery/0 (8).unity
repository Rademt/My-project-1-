  m_text: "\u0412\u0456\u0442\u0430\u044E! \u0412\u0438 \u043F\u0435\u0440\u0435\u043C\u043E\u0433\u043B\u0438
    \u0443 \u0446\u0456\u0439 \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u0456\u0439
    \u0433\u0440\u0456, \u0442\u0430 \u0432\u0438\u0431\u0440\u0430\u043B\u0438\u0441\u044F
    \u0437 \u0446\u0438\u043A\u043B\u0456\u0447\u043D\u043E\u0433\u043E \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0443
